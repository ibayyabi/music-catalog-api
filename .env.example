# Server Configuration
PORT=3002
NODE_ENV=production

# Database Configuration (Docker MySQL)
# IMPORTANT: DB_USER tidak boleh 'root' - gunakan nama user biasa
DB_HOST=mysql
DB_PORT=3306
DB_USER=music_user
DB_PASSWORD=your-secure-password-here
DB_NAME=music_service_db
DB_TABLE=tabel_musik

# Connection Pool Settings (optimized for STB)
DB_CONNECTION_LIMIT=2
DB_QUEUE_LIMIT=5

# API Security
API_KEY=your-api-key-here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
